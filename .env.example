ADMIN_TOKEN=token-para-diagnosticos-administrativos
PUBLIC_BASE_URL=https://seu-dominio.example

# E-mails do ChatGPT autorizados a usar a caixa de entrada, separados por vírgula.
INBOX_ALLOWED_EMAILS=voce@example.com

# Opcional: endpoint próprio/licenciado. Compatível com uma instância privada do Cobalt.
REEL_RESOLVER_URL=
REEL_RESOLVER_TOKEN=
REEL_RESOLVER_AUTH_SCHEME=Api-Key

# Executor alternativo gratuito para quando o provedor principal sofrer bloqueio de IP.
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=Nelmir12/reelvolt-studio
REEL_DOWNLOAD_WORKFLOW_ID=reel-downloader.yml
REEL_DOWNLOAD_WORKFLOW_REF=master
# Configure o mesmo segredo como REEL_DOWNLOAD_WORKER_SECRET no Sites e no GitHub.
# Durante a migração, o sistema aceita o YOUTUBE_WORKER_SECRET histórico já existente.
REEL_DOWNLOAD_WORKER_SECRET=

# Publicação oficial de Reels pela Meta.
# Use Instagram Login (graph.instagram.com) ou Facebook Login (graph.facebook.com).
INSTAGRAM_GRAPH_HOST=graph.instagram.com
INSTAGRAM_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Entrada automatizada pelo Instagram Direct. O segredo do app e o token de
# verificação devem ser cadastrados como segredos no provedor, nunca no Git.
INSTAGRAM_DIRECT_ALLOWED_USERNAME=nelmirjr
META_APP_SECRET=
META_VERIFY_TOKEN=

# Segredo aleatório usado somente para URLs temporárias do MP4 consumidas pela Meta.
PUBLISH_URL_SECRET=
