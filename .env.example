ADMIN_TOKEN=token-para-diagnosticos-administrativos
PUBLIC_BASE_URL=https://seu-dominio.example

# E-mails do ChatGPT autorizados a usar a caixa de entrada, separados por vírgula.
INBOX_ALLOWED_EMAILS=voce@example.com

# Opcional: endpoint próprio/licenciado. Compatível com uma instância privada do Cobalt.
REEL_RESOLVER_URL=
REEL_RESOLVER_TOKEN=
REEL_RESOLVER_AUTH_SCHEME=Api-Key

# Publicação oficial de Reels pela Meta.
# Use Instagram Login (graph.instagram.com) ou Facebook Login (graph.facebook.com).
INSTAGRAM_GRAPH_HOST=graph.instagram.com
INSTAGRAM_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Segredo aleatório usado somente para URLs temporárias do MP4 consumidas pela Meta.
PUBLISH_URL_SECRET=

# YouTube OAuth 2.0 server-side. O refresh token criptografado fica somente no D1.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_TOKEN_SECRET=
YOUTUBE_API_AUDITED=false

# Executor sob demanda no GitHub Actions. O token deve permitir somente Actions neste repositório.
YOUTUBE_WORKER_SECRET=
YOUTUBE_EXECUTOR_MODE=github
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=Nelmir12/reelvolt-studio
GITHUB_WORKFLOW_ID=youtube-uploader.yml
GITHUB_WORKFLOW_REF=master

# Contas próprias permitidas para rightsBasis=owned.
OWNED_SOURCE_ACCOUNTS=@btsupply_

# Opcional e pago. Sem esta chave, o upload privado usa metadados provisórios e
# exige revisão humana explícita no painel antes da liberação pública.
OPENAI_API_KEY=
OPENAI_METADATA_MODEL=gpt-5.6-terra
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_MODERATION_MODEL=omni-moderation-latest
